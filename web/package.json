{
  "name": "newcloud-web",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "gen:api": "openapi-typescript openapi.yaml -o src/api-types.ts",
    "gen:api:check": "openapi-typescript openapi.yaml -o src/api-types.ts && git diff --exit-code -- src/api-types.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
