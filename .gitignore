# Compiled binary
/newcloud
bin/
*.exe
# Windows leaves these behind when a running binary is replaced by a rebuild.
*.exe~
*~

# Local run artifacts
testdata-run/
r8/
# State written by `go run ./tools/demo`: a config with a throwaway secret, blobs,
# the compiled binary and the app log.
demo-run/
shots/
*.log

# The browser client: dependencies are not committed, but the build output is, because the Go
# embed directive needs it for a plain `go build` to work.
web/node_modules/
web/dist/

# Secrets: never commit these
*.pass
config.yml
!deploy/config.example.yml

# Local package-manager cache (not project source).
.pnpm-store/
