# Compiled binary
/newcloud
bin/
*.exe
# Windows leaves these behind when a running binary is replaced by a rebuild.
*.exe~
*~

# Local run artifacts
testdata-run/
r8/
# State written by `go run ./tools/demo`: a config with a throwaway secret, blobs,
# the compiled binary and the app log.
demo-run/
shots/
*.log
# State written by `go run ./tools/demoinmem` (the no-Docker demo).
.demo-inmem/
# Stray root-level Vite output; the real bundle is written to internal/webassets/dist.
/app.css
/app.js
# Captures produced by the UI screenshot harness.
/demo-capture.html
/demo-capture.template.html
/demo-data.json
/shell.html
# The browser client: dependencies are not committed, but the build output is, because the Go
# embed directive needs it for a plain `go build` to work.
web/node_modules/
web/dist/
# Secrets: never commit these
*.pass
config.yml
!deploy/config.example.yml
# Local package-manager cache (not project source).
.pnpm-store/
# Local design-exploration material. The frozen Cirrus 9.1 baseline is recorded in
# docs/reference/cirrus-9.1-integration-plan.md; the working rounds stay on this machine.
/design-studio/
# Standalone UI-kit checkout destined for its own repository, not this one.
/cirrus-ui/
# Review-session scratch: subsystem notes, screenshots and a HEAD snapshot copy.
/.review-notes/
dist/

# Screenshots and results from web/scripts/ui-verify.mjs: regenerable evidence, not source.
/web/artifacts/
# Vite/esbuild scratch inside the client.
/web/.tmp/

