{
	# Two vhosts on purpose: the app origin and the content origin must differ,
	# otherwise a stored-XSS payload in an uploaded file can read the session
	# cookie and drive the authenticated UI.
	#
	# Where the boundary is enforced, and what each layer is responsible for:
	#
	#   1. This proxy. The application vhost refuses /content/* outright so a
	#      cross-origin content URL aimed at the wrong hostname dies before it
	#      reaches the application, and the attempt shows up in the proxy log. The
	#      content vhost proxies ONLY the content listener.
	#
	#   2. The application listener (:8080). It refuses /content/* and answers the
	#      two share content routes with a redirect to the content origin carrying a
	#      short-lived capability. It does NOT serve share bytes itself, because the
	#      landing page's gate is the only place the password/recipient cookies are
	#      available — the content hostname never receives them.
	#
	#   3. The content listener (:8081). Three routes, 404 to everything else
	#      whatever Host header it is given.
	#
	# What none of this does: authenticated API routes (/api/files/download,
	# /api/files/version, /api/files/thumbnail, /api/shared/{id}/content) and WebDAV
	# still serve a signed-in user their own bytes on the application origin. That is
	# deliberate and documented in docs/guides/limitations.md; moving them would hand
	# the content origin session authentication, which is the isolation the split
	# exists to provide.
	#
	# Prerequisites in config.yml:
	#
	#   server:
	#     addr: ":8080"                    # application
	#     usercontent_addr: ":8081"        # content — REQUIRED for this topology
	#     public_url: "https://cloud.example.com"
	#     usercontent_url: "https://usercontent.example.com"
	#
	# and the web service must publish both ports (see docker-compose.yml).

	cloud.example.com {
		encode zstd gzip

		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Permissions-Policy "geolocation=(), microphone=(), camera=()"
			-Server
		}

		# Refuse /content/* on the application origin.
		#
		# /s/{token}/download and /s/{token}/thumbnail are deliberately NOT refused here.
		# They must reach the application, which runs the share's gate against its own
		# host-only cookies and then redirects to the content origin with a capability.
		# Blocking them at the proxy is what made every password-protected and
		# recipient-verified share undownloadable: the browser stayed on this hostname,
		# got a 404, and the visitor had no way to reach the bytes (PRG-002).
		@content path /content/*
		handle @content {
			respond "Not Found" 404
		}

		# Operational endpoints are NOT public.
		#
		# The application registers /metrics without authentication (a scraper cannot use a
		# session cookie) and /readyz echoes dependency errors. This file used to proxy
		# everything else to the app, which published request volumes, upload failure rates,
		# break-glass attempts, WAL state and scrub corruption counts to the internet — while
		# prometheus.example.yml in the same directory warned not to do exactly that
		# (2026-10-24 review, H4). The app listener is bound to 127.0.0.1, so a scraper on the
		# host can still reach both; anything else must be a deliberate decision to add a vhost.
		@ops path /metrics /readyz
		handle @ops {
			respond "Not Found" 404
		}

		# Both branches are `handle` blocks so they stay mutually exclusive. A bare
		# `reverse_proxy` beside a `handle` is ordered by directive priority and can run
		# for the refused path too, which would defeat the refusal.
		handle {
			reverse_proxy web:8080
		}
	}

	usercontent.example.com {
		encode zstd gzip

		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			# User content is never a document: force download and sandbox it.
			Content-Security-Policy "sandbox; default-src 'none'; img-src 'self'; media-src 'self'"
			Content-Disposition "attachment"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			X-Robots-Tag "noindex, nofollow, noarchive"
			-Server
		}

		# This vhost proxies ONLY the content listener. Pointing it at web:8080 would work
		# only while the application happened to refuse the same paths, and the point of
		# the split is not to depend on that.
		reverse_proxy web:8081 {
			# Strip the incoming Cookie header on the way UPSTREAM (PRG-004).
			#
			# `header { -Cookie }` manipulates RESPONSE headers in Caddy; it does not touch
			# the request the backend receives. The earlier version of this file used that
			# and its comment claimed the content origin never sees a session cookie, which
			# was false. `header_up` is the request direction.
			#
			# Defence in depth rather than the boundary: the browser does not send the app's
			# host-only cookies to this hostname, and the content listener reads no session
			# cookie. It exists so that a proxy misconfiguration, a rewritten Host, or a
			# future non-host-only cookie cannot silently reintroduce the exposure.
			header_up -Cookie
		}
	}
}
