{
	# Two vhosts on purpose: the app origin and the content origin must differ,
	# otherwise a stored-XSS payload in an uploaded file can read the session
	# cookie and drive the authenticated UI.
	#
	# NC-RR-006: the boundary is enforced in THREE places, and all three are needed.
	#
	#   1. This proxy: the application vhost refuses every content-delivery path
	#      outright, and the content vhost refuses everything that is not one.
	#   2. The application listener (:8080): with server.usercontent_addr set it does
	#      not register the content routes at all; with it unset they are gated by a
	#      ticket, which is the documented smaller-deployment mode.
	#   3. The content listener (:8081): it registers exactly three routes and answers
	#      404 to everything else, whatever Host header it is given.
	#
	# Only (1) was present before, and it was inactive because both vhosts proxied to
	# the same port while usercontent_addr was unset. The hostname validation that did
	# exist never established "user bytes are served only on the content host".
	#
	# Prerequisites in config.yml:
	#
	#   server:
	#     addr: ":8080"                    # application
	#     usercontent_addr: ":8081"        # content — REQUIRED for this topology
	#     public_url: "https://cloud.example.com"
	#     usercontent_url: "https://usercontent.example.com"
	#
	# and the web service must publish both ports (see docker-compose.yml).

	cloud.example.com {
		encode zstd gzip

		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Permissions-Policy "geolocation=(), microphone=(), camera=()"
			-Server
		}

		# Refuse user-content paths on the application origin.
		#
		# The server refuses these itself, so this looks redundant — it is not. It
		# stops the request before it reaches the application at all, which means:
		#   - a future route accidentally registered on the app origin is unreachable;
		#   - the application's own 404 does not have to be the only thing standing
		#     between the app's cookie jar and a user's file;
		#   - the refusal is visible in the proxy log, which is what tells an operator
		#     that something is generating cross-origin content URLs.
		#
		# /s/{token}/download and /s/{token}/thumbnail are included because they are
		# content routes too. Leaving them out was the original gap: the share landing
		# page stays on this origin (it holds the password cookie) but its BYTES do
		# not, and the route inventory has to reflect both facts.
		# Refuse ONLY /content/* on the application origin.
		#
		# The server refuses it too, so this looks redundant — it is not. It stops the request
		# before it reaches the application at all, and it makes a cross-origin content URL being
		# generated against the app hostname visible in the proxy log.
		#
		# /s/{token}/download and /s/{token}/thumbnail are deliberately NOT refused here. Those two
		# paths must be handled by the application origin, because that origin is the only one that
		# holds the password/recipient gate cookies. It answers them with a redirect to the content
		# origin carrying a short-lived capability bound to that share and file (PRG-002). Blocking
		# them at the proxy is what made every gated share undownloadable: the browser stayed on
		# cloud.example.com, got a 404, and the visitor had no way to reach the bytes.
		@content path /content/*
		handle @content {
			respond "Not Found" 404
		}
		# Both branches are `handle` blocks so they are mutually exclusive. A bare
		# `reverse_proxy` next to a `handle` would be ordered by directive priority and could
		# run for the refused path too, which would defeat the refusal.
		handle {
			reverse_proxy web:8080
		}
	}

	usercontent.example.com {
		encode zstd gzip

		header {
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
			X-Content-Type-Options "nosniff"
			# User content is never a document: force download and sandbox it.
			Content-Security-Policy "sandbox; default-src 'none'; img-src 'self'; media-src 'self'"
			Content-Disposition "attachment"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			X-Robots-Tag "noindex, nofollow, noarchive"
			-Server
		}

		# This vhost proxies ONLY the content listener. Pointing it at web:8080 would
		# work only while the application happened to refuse those same paths, and
		# the point of the split is to not depend on that.
		reverse_proxy web:8081 {
			# Strip the incoming Cookie header on the way UPSTREAM (PRG-004).
			#
			# `header { -Cookie }` in a Caddyfile manipulates RESPONSE headers; it does not
			# touch the request the backend receives. The previous version used that and its
			# comment claimed it stopped the content origin from ever seeing a session cookie,
			# which was simply false. `header_up` is the request direction.
			#
			# This is defence in depth, not the boundary: the browser does not send the app's
			# host-only cookies to this hostname in the first place, and the content listener
			# reads no session cookie. It exists so that a proxy misconfiguration, a rewritten
			# Host, or a future non-host-only cookie cannot silently reintroduce the exposure.
			header_up -Cookie
			# The ticket travels in the query string and must not be echoed back in a redirect
			# or a log the client can read.
			header_up -X-Forwarded-Cookie
		}
	}
}
