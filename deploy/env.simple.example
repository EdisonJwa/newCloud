# Copy to .env (in this directory) and fill in every value:
#   cp env.simple.example .env
# Compose reads it automatically. .env is gitignored; this example is the committed
# template.

# --- Required ---------------------------------------------------------------

# The two origins. Different HOSTNAMES, not just ports: cookies live on the first,
# uploaded content is served from the second.
PUBLIC_DOMAIN=cloud.example.com
USERCONTENT_DOMAIN=usercontent.example.com

# Your OIDC provider (Pocket ID, Keycloak, ...). The client must exist there, with a
# redirect allowed back to https://$PUBLIC_DOMAIN.
OIDC_ISSUER=https://idp.example.com
OIDC_CLIENT_ID=newcloud
OIDC_CLIENT_SECRET=change-me

# Signs session cookies. Generate one: openssl rand -base64 48
SESSION_SECRET=change-me-at-least-32-bytes-long

# --- Database ----------------------------------------------------------------
# Two DIFFERENT passwords: the owner runs migrations, newcloud_app serves requests and
# cannot rewrite the audit log. Sharing them gives that property up.
# Generate each: openssl rand -base64 32
PG_PASSWORD=change-me
PG_APP_PASSWORD=change-me-too

# --- Optional ----------------------------------------------------------------
# Image tag metadata only: what `newcloud --version` reports. Defaults to "dev".
# NEWCLOUD_VERSION=$(git rev-parse --short HEAD)

# Storage layout: blob (deduplicated, cheap versions) or tree (ls/rsync-friendly).
# Chosen once per deployment; the shape on disk cannot be mixed later.
# NEWCLOUD_STORAGE_LAYOUT=blob

# Outbound mail for share invitations and expiry reminders (M4).
# NEWCLOUD_MAIL_ENABLED=true
# NEWCLOUD_MAIL_HOST=smtp.example.com
# NEWCLOUD_MAIL_PORT=587
# NEWCLOUD_MAIL_USERNAME=newcloud@example.com
# NEWCLOUD_MAIL_PASSWORD=change-me
# NEWCLOUD_MAIL_FROM=newcloud@example.com

# ClamAV scanning (M5): enable only with a reachable clamd; the compose file above has
# no clamd service, so this stays off unless you add one.
# NEWCLOUD_ANTIVIRUS_ENABLED=false
# NEWCLOUD_ANTIVIRUS_HOST=127.0.0.1:3310
